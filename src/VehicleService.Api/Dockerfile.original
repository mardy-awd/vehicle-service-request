FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["src/VehicleService.Core/VehicleService.Core.csproj", "src/VehicleService.Core/"]
COPY ["src/VehicleService.Api/VehicleService.Api.csproj", "src/VehicleService.Api/"]

RUN dotnet restore "src/VehicleService.Api/VehicleService.Api.csproj"

COPY . .

RUN dotnet publish "src/VehicleService.Api/VehicleService.Api.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8080

ENTRYPOINT ["dotnet", "VehicleService.Api.dll"]