@model List<VehicleService.Web.Models.Vehicles.VehicleViewModel>

@{
    ViewData["Title"] = "My Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">My Vehicles</h2>
        <p class="text-muted mb-0">
            Manage your registered vehicles.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Vehicle
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5>No vehicles registered yet</h5>
                <p class="text-muted">
                    Add your first vehicle to create service requests.
                </p>
                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Vehicle
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Make</th>
                            <th>Model</th>
                            <th>Registration</th>
                            <th>Year</th>
                            <th>Mileage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vehicle in Model)
                        {
                            <tr>
                                <td>@vehicle.Make</td>
                                <td>@vehicle.Model</td>
                                <td>@vehicle.RegistrationNumber</td>
                                <td>@vehicle.Year</td>
                                <td>@vehicle.Mileage.ToString("N0") km</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>