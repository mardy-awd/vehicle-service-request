@model VehicleService.Web.Models.Dashboard.DashboardSummaryViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Dashboard";

    var role = User.FindFirstValue(ClaimTypes.Role);
}

<div class="mb-4">
    <h2 class="fw-bold">Dashboard</h2>
    <p class="text-muted">
        Overview of your vehicle service requests.
    </p>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total Requests</p>
                <h2 class="fw-bold">@Model.TotalRequests</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Active Requests</p>
                <h2 class="fw-bold text-primary">
                    @Model.ActiveRequests
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Completed</p>
                <h2 class="fw-bold text-success">
                    @Model.CompletedRequests
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Pending</p>
                <h2 class="fw-bold text-warning">
                    @Model.PendingRequests
                </h2>
            </div>
        </div>
    </div>

</div>

@if (role == "VehicleOwner")
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>My Vehicles</h5>
            <h2>@Model.TotalVehicles</h2>
            <p class="text-muted mb-0">
                Registered vehicles
            </p>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">Request Status Overview</h5>
    </div>

    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                Assigned: <strong>@Model.AssignedRequests</strong>
            </div>

            <div class="col-md-4">
                Accepted: <strong>@Model.AcceptedRequests</strong>
            </div>

            <div class="col-md-4">
                In Progress: <strong>@Model.InProgressRequests</strong>
            </div>

            <div class="col-md-4">
                Closed: <strong>@Model.ClosedRequests</strong>
            </div>

            <div class="col-md-4">
                Cancelled: <strong>@Model.CancelledRequests</strong>
            </div>
        </div>
    </div>
</div>