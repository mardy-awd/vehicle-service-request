@model VehicleService.Web.Models.ServiceRequests.AssignProviderViewModel

@{
    ViewData["Title"] = "Assign Service Provider";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <h2 class="fw-bold">Assign Service Provider</h2>
            <p class="text-muted">
                Select a provider to handle this service request.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Assign" method="post">
                    <input asp-for="ServiceRequestId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="ProviderId"
                               class="form-label">
                            Service Provider
                        </label>

                        <select asp-for="ProviderId"
                                asp-items="Model.Providers"
                                class="form-select">
                            <option value="">Select a provider</option>
                        </select>

                        <span asp-validation-for="ProviderId"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@(Model.Providers.Count == 0)">
                            Assign Provider
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.ServiceRequestId"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>

                @if (Model.Providers.Count == 0)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        No active service providers are available.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}