# PostgreSQL
POSTGRES_PASSWORD=replace-with-strong-database-password

# JWT Authentication
JWT_ISSUER=VehicleService.Api
JWT_AUDIENCE=VehicleService.Client
JWT_KEY=replace-with-secure-random-signing-key
Jwt__ExpiryMinutes=60

# Seed Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_ADMIN_FULLNAME=System Administrator