{
  "info": {
    "name": "Vehicle Service API - Guided Workflow",
    "_postman_id": "bf0e7e3b-45c2-44be-a91a-3e812cc965dd",
    "description": "Run folders 01, 02, 03, 04 in sequence. Folder 05 is an alternative scenario; folder 06 contains authorization checks. Set passwords in your private Postman environment. IDs and JWTs are saved as collection variables during execution; clear them before exporting the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Accounts & Authentication",
      "description": "Run in order on a fresh database or clear generated ownerEmail/providerEmail variables for new sample accounts. Enter Admin credentials and sample passwords in the environment before running.",
      "item": [
        {
          "name": "01 - Admin | Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"admin token returned\", () => pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"adminToken\", data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Admin | Create provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/providers",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sample Service Provider\",\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{providerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"providerEmail\")) { pm.collectionVariables.set(\"providerEmail\", \"provider.\" + Date.now() + \"@example.test\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Provider ID returned\", () => pm.expect(data.userId).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"providerId\", data.userId);"
                ]
              }
            }
          ]
        },
