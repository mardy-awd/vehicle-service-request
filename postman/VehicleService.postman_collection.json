    {
      "name": "03 - Main Service Lifecycle",
      "description": "Run sequentially. The status transitions are not repeatable on the same request. To rerun, create a new service request first.",
      "item": [
        {
          "name": "01 - Owner | Create request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/service-requests",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"serviceType\": \"OilChange\",\n  \"issueDescription\": \"Oil change and routine inspection requested.\",\n  \"preferredServiceAtUtc\": \"{{preferredServiceAtUtc}}\",\n  \"timeSlot\": \"Morning\",\n  \"pickupRequired\": false,\n  \"pickupAddress\": null,\n  \"contactPhoneNumber\": \"+201001234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"preferredServiceAtUtc\", new Date(Date.now() + 7*24*60*60*1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"serviceRequestId returned\", () => pm.expect(data.id).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"serviceRequestId\", data.id);"
                ]
              }
            }
          ]
        },
