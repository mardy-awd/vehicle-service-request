    {
      "name": "05 - Alternative Flows (Manual)",
      "description": "Run after the main workflow; uses alternativeRequestId, not serviceRequestId. Start at step 01 each time.",
      "item": [
        {
          "name": "01 - Owner | Create request for rejection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/service-requests",
            "description": "",
            "auth": {
              "type": "bearer",
